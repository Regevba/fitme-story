# fitme-story — environment variable template
#
# Copy this file to `.env.local` and fill in values. Never commit `.env.local`
# (it's gitignored via `.env*` with `.env.example` as the only explicit exception).
#
# For production / preview deployments, set these in the Vercel dashboard:
#   https://vercel.com/regevba-3729s-projects/fitme-story/settings/environment-variables
#
# Last updated: 2026-05-13 (analytics-observability Phase 1.A.6)

# ─────────────────────────────────────────────────────────────────────
# Public (NEXT_PUBLIC_*) — exposed to client; safe in browser
# ─────────────────────────────────────────────────────────────────────

# Google Analytics 4 measurement ID. Wired via `@next/third-parties/google`
# in `src/app/layout.tsx`. Format: G-XXXXXXXXXX (10 chars after G-).
# Without this, the analytics tags don't load and the `/control-room/analytics`
# route (Phase 3 of analytics-observability) has no data source.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ─────────────────────────────────────────────────────────────────────
# Operations Control Room (UCC = Unified Control Center)
# ─────────────────────────────────────────────────────────────────────

# Auth mode for /control-room/* routes.
#   - basic    — HTTP Basic Auth (DASHBOARD_USER/DASHBOARD_PASS)
#   - passkey  — WebAuthn (UCC_RP_ID/UCC_RP_ORIGIN/UCC_SESSION_SECRET)
#   - public   — no auth (DEV ONLY; never use in prod)
# Production runbook: docs/setup/ucc-passkey-auth-setup-guide.md (FT2 repo)
UCC_AUTH_MODE=basic

# Basic-auth credentials (used when UCC_AUTH_MODE=basic)
DASHBOARD_USER=operator
DASHBOARD_PASS=change-me

# Passkey/WebAuthn config (used when UCC_AUTH_MODE=passkey)
# UCC_RP_ID: the relying-party identifier; typically your domain (no scheme).
# UCC_RP_ORIGIN: full origin including scheme; must be HTTPS in prod.
# UCC_SESSION_SECRET: random 32+ byte hex string; rotate periodically.
UCC_RP_ID=localhost
UCC_RP_ORIGIN=http://localhost:3000
UCC_SESSION_SECRET=

# Audit-log persistence (Vercel Blob)
# UCC_AUDIT_BLOB_TOKEN: same as BLOB_READ_WRITE_TOKEN; separate var for clarity.
UCC_AUDIT_BLOB_TOKEN=
UCC_AUDIT_BLOB_ENDPOINT=
UCC_AUDIT_BLOB_PATH=control-room/audit-log.jsonl
UCC_AUDIT_LIVE_PATH=control-room/audit-live.jsonl

# Public-mode allow flag (DEV ONLY; never set in prod)
DASHBOARD_PUBLIC=

# ─────────────────────────────────────────────────────────────────────
# Cross-repo sync (build-time)
# ─────────────────────────────────────────────────────────────────────

# Path to FT2 (FitTracker2) repo clone — used by build-time sync script
# at `scripts/sync-from-fittracker2.ts`. In CI, build process clones FT2.
# In local dev, point at your local FT2 checkout.
FITTRACKER_REPO_PATH=/Volumes/DevSSD/FitTracker2

# Cron auth shared secret for cross-repo state-sync workflows.
# Generated once + stored in both FT2 + fitme-story Vercel secrets.
CRON_SECRET=

# Vercel Blob storage (read/write) — for audit log + sync mirrors.
# Auto-provisioned by Vercel Marketplace; pull via `vercel env pull`.
BLOB_READ_WRITE_TOKEN=

# ─────────────────────────────────────────────────────────────────────
# Runtime hints (rarely set manually)
# ─────────────────────────────────────────────────────────────────────

# NODE_ENV is set automatically by Node.js / Next.js based on the command:
#   - `next dev`     → "development"
#   - `next build`   → "production"
#   - `next start`   → "production"
# Setting manually is rarely needed; documented here for completeness.
NODE_ENV=development
